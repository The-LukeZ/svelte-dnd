{
    "name": "svelte-dnd-monorepo",
    "private": true,
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "pnpm --filter @lukez/svelte-dnd build",
        "test": "pnpm --filter @lukez/svelte-dnd test",
        "check:package": "pnpm --filter @lukez/svelte-dnd check:package",
        "lint": "oxlint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "9.1.7",
        "lint-staged": "17.6.1",
        "oxlint": "1.94.0",
        "prettier": "3.10.1",
        "prettier-plugin-svelte": "4.2.0"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,svelte}": [
            "oxlint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css}": "prettier --write"
    }
}
