{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "types": ["vitest/globals"]
    },
    "include": ["src", "test", "vitest.config.mts"],
    "exclude": ["test/**/*.test-d.ts", "dist"]
}
