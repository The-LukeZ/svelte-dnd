{
    "name": "@lukez/svelte-dnd",
    "description": "Drag and drop for Svelte: rich animations, nested containers, touch, keyboard and screen reader support. Fork of svelte-dnd-action.",
    "version": "0.9.80",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/The-LukeZ/svelte-dnd.git",
        "directory": "packages/svelte-dnd"
    },
    "author": "LukeZ",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/The-LukeZ/svelte-dnd/issues"
    },
    "homepage": "https://github.com/The-LukeZ/svelte-dnd#readme",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest run --project chromium",
        "test:all": "vitest run",
        "test:types": "tsc -p tsconfig.types.json",
        "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
        "check:exports": "node scripts/check-exports.mjs",
        "check:package": "node scripts/check-exports.mjs && publint && attw --pack"
    },
    "dependencies": {},
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@vitest/browser-playwright": "5.1.1",
        "playwright": "1.65.1",
        "publint": "0.3.25",
        "svelte": "5.58.0",
        "svelte-check": "4.7.8",
        "tsdown": "0.23.7",
        "typescript": "6.0.3",
        "vitest": "5.1.1",
        "vitest-browser-svelte": "3.1.0"
    },
    "peerDependencies": {
        "svelte": "^5.32.0"
    },
    "keywords": [
        "svelte",
        "drag and drop",
        "sortable",
        "dnd",
        "draggable",
        "accessible",
        "touch"
    ],
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    }
}
